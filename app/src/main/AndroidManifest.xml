<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_zh"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_zh"
        android:supportsRtl="true"
        android:theme="@style/Theme.MultilingualHelloWorld">
        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <activity-alias
            android:name=".launcher.Chinese"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_zh"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.English"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_en"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".launcher.French"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_fr"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
